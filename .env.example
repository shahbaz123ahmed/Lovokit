# ========================================================
# LOVOKIT E-COMMERCE & B2B PROCUREMENT PLATFORM
# Environment Variables Configuration Template
# ========================================================

# 1. APPLICATION ENVIRONMENT
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. DATABASE CONFIGURATION (Choose MongoDB or PostgreSQL/MySQL)
# Option A: MongoDB (Mongoose / Native Driver)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.lovokit.mongodb.net/lovokit_db?retryWrites=true&w=majority

# Option B: PostgreSQL / MySQL (Prisma ORM)
DATABASE_URL="postgresql://postgres:password@localhost:5432/lovokit_db?schema=public"

# 3. AUTHENTICATION & SECURITY
NEXTAUTH_SECRET=generate_a_random_32_byte_secret_here_for_nextauth
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=lovokit_enterprise_jwt_super_secret_key_2026
ADMIN_SECRET_KEY=lovokit_master_admin_access_key

# 4. CLOUD MEDIA STORAGE (For Product Images & Manuals Uploads)
# Cloudinary Option:
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# OR AWS S3 Option:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET_NAME=lovokit-product-media

# 5. BUSINESS & NOTIFICATIONS (Optional SMTP for Orders/Quotes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sales@lovosis.in
SMTP_PASS=your_email_app_password
ADMIN_NOTIFICATION_EMAIL=sales@lovosis.in
