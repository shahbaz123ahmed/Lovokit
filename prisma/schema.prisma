// ========================================================
// LOVOKIT PRISMA SCHEMA DEFINITION
// Compatible with PostgreSQL, MySQL, CockroachDB
// ========================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------
// 1. BRAND ENTITY
// --------------------------------------------------------
model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  description String?
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

// --------------------------------------------------------
// 2. CATEGORY ENTITY
// --------------------------------------------------------
model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  slug          String        @unique
  description   String?
  image         String?
  icon          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subcategories Subcategory[]
  products      Product[]
}

// --------------------------------------------------------
// 3. SUBCATEGORY ENTITY
// --------------------------------------------------------
model Subcategory {
  id          String    @id @default(cuid())
  name        String
  slug        String
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@unique([slug, categoryId])
}

// --------------------------------------------------------
// 4. PRODUCT ENTITY (Instruments & Bench Tools)
// --------------------------------------------------------
model Product {
  id              String        @id @default(cuid())
  model           String        @unique
  slug            String        @unique
  title           String
  description     String        @db.Text
  brandId         String
  brand           Brand         @relation(fields: [brandId], references: [id])
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  subcategoryId   String?
  subcategory     Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  price           Decimal       @db.Decimal(12, 2)
  originalPrice   Decimal?      @db.Decimal(12, 2)
  inStock         Boolean       @default(true)
  stockQuantity   Int           @default(10)
  featured        Boolean       @default(false)
  badgeTitle      String?
  badgeSubtitle   String?
  badgeType       String?

  rating          Float         @default(5.0)
  reviewsCount    Int           @default(0)

  mainImage       String
  galleryImages   String[]      @default([])

  // JSON fields for instrument specifications
  specs           Json?         // Array of { label: string, value: string }
  detailedSpecs   Json?         // Object { vertical: [...], horizontal: [...], trigger: [...], general: [...] }
  documents       Json?         // Datasheets, calibration certificates, user manuals

  hsnCode         String?       @default("90302000") // Harmonized System Code for Scopes & Lab Instruments
  gstRate         Float?        @default(18.0)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// --------------------------------------------------------
// 5. B2B QUOTE / RFP REQUEST ENTITY
// --------------------------------------------------------
model QuoteRequest {
  id            String    @id @default(cuid())
  fullName      String
  email         String
  phone         String
  company       String?
  gstNumber     String?
  packageType   String?   // e.g. "Automotive EV Station", "Custom Lab RFP"
  requestedItems Json?    // Array of product IDs and quantities
  budget        String?
  notes         String?   @db.Text
  status        String    @default("PENDING") // PENDING, IN_REVIEW, QUOTED, CLOSED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// --------------------------------------------------------
// 6. ADMIN & USER ENTITY
// --------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  phone         String?
  company       String?
  role          String    @default("CUSTOMER") // ADMIN, SALES, CUSTOMER
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
